<Project Sdk="Microsoft.NET.Sdk">

    <!-- Isolated unit tests. Not part of Vsky.sln and not referenced by the API, so it does not affect build/publish. -->
    <PropertyGroup>
        <TargetFramework>net7.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
        <PackageReference Include="xunit" Version="2.6.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4" />
        <PackageReference Include="Moq" Version="4.20.70" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="7.0.15" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vsky.Api\Vsky.Api.csproj" />
    </ItemGroup>

</Project>
